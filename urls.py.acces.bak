    ),

    path(
        "<int:pk>/autorisations-confidentielles/<int:autorisation_id>/revoquer/",
        views.revoquer_autorisation_confidentielle,
        name="revoquer_autorisation_confidentielle",
    ),

    # ========================================================
    # TÉLÉCHARGEMENT DES DOCUMENTS
