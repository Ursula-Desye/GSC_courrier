
from django.urls import path

from . import views, bordereaux, exports


urlpatterns = [

    # ========================================================
    # TABLEAU DE BORD ET REGISTRE
    # ========================================================

    path(
        "dashboard/",
        views.dashboard,
        name="dashboard_interne",
    ),

    path(
        "",
        views.liste_courriers,
        name="liste_courriers",
    ),

    path(
        "nouveau/",
        views.nouveau_courrier,
        name="nouveau_courrier",
    ),

    # ========================================================
    # EXPORTS
